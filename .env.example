# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Accounts: sign-up is open by default. Require an invite code, or close it once your users exist.
# SIGNUP_CODE=
# ALLOW_SIGNUP=false
# Where SQLite, git repos, and blobs live (default ./data)
# DATA_DIR=
# Parallel jobs
# COMPILE_CONCURRENCY=2
# CLAUDE_CONCURRENCY=2
# PORT=3000
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium
# Google sign-in (Google Cloud Console > Credentials > OAuth client ID, Web application;
# authorize <APP_URL>/api/auth/google/callback as a redirect URI)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# APP_URL=https://resume.example.com
# PostHog product analytics (project API key; host for EU: https://eu.i.posthog.com)
# POSTHOG_KEY=
# POSTHOG_HOST=https://us.i.posthog.com
