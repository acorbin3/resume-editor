<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Copy to ~/Library/LaunchAgents/com.example.resume-editor.plist and replace /path/to and USER. -->
<plist version="1.0"><dict>
  <key>Label</key><string>com.example.resume-editor</string>
  <key>WorkingDirectory</key><string>/path/to/resume-editor</string>
  <key>ProgramArguments</key><array>
    <string>/opt/homebrew/bin/node</string>
    <string>--env-file-if-exists=.env</string>
    <string>server.js</string>
  </array>
  <key>EnvironmentVariables</key><dict>
    <!-- Must include tectonic, pdftotext/pdfinfo, and (without an API key) the claude CLI. -->
    <key>PATH</key><string>/opt/homebrew/bin:/Users/USER/.npm-global/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOME</key><string>/Users/USER</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/path/to/resume-editor/logs/server.log</string>
  <key>StandardErrorPath</key><string>/path/to/resume-editor/logs/server.log</string>
</dict></plist>
